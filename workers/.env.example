# ============================================
# Taiwan Payment Gateway - Environment Variables
# ============================================
# 
# This file contains all required environment variables for the payment gateway integration.
# Copy this file to .env and fill in your actual values.
# 
# IMPORTANT: Never commit .env files with real credentials to version control!
# ============================================

# --------------------------------------------
# Environment Configuration
# --------------------------------------------
# Set to 'test' for testing or 'production' for live transactions
PAYMENT_ENVIRONMENT=test

# Frontend URL (for payment return redirects)
FRONTEND_URL=http://localhost:3000

# API URL (for payment callbacks)
API_URL=http://localhost:8787

# --------------------------------------------
# NewebPay (蓝新金流) Configuration
# --------------------------------------------
# Get these credentials from NewebPay merchant portal
# Test: https://cwww.newebpay.com/
# Production: https://www.newebpay.com/

# Test Environment
NEWEBPAY_TEST_MERCHANT_ID=your_test_merchant_id
NEWEBPAY_TEST_HASH_KEY=your_test_hash_key
NEWEBPAY_TEST_HASH_IV=your_test_hash_iv
NEWEBPAY_TEST_API_URL=https://ccore.newebpay.com/MPG/mpg_gateway

# Production Environment
NEWEBPAY_PROD_MERCHANT_ID=your_prod_merchant_id
NEWEBPAY_PROD_HASH_KEY=your_prod_hash_key
NEWEBPAY_PROD_HASH_IV=your_prod_hash_iv
NEWEBPAY_PROD_API_URL=https://core.newebpay.com/MPG/mpg_gateway

# NewebPay API Version
NEWEBPAY_VERSION=2.0

# --------------------------------------------
# ECPay (绿界科技) Configuration
# --------------------------------------------
# Get these credentials from ECPay merchant portal
# Test: https://vendor-stage.ecpay.com.tw/
# Production: https://www.ecpay.com.tw/

# Test Environment
ECPAY_TEST_MERCHANT_ID=your_test_merchant_id
ECPAY_TEST_HASH_KEY=your_test_hash_key
ECPAY_TEST_HASH_IV=your_test_hash_iv
ECPAY_TEST_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# Production Environment
ECPAY_PROD_MERCHANT_ID=your_prod_merchant_id
ECPAY_PROD_HASH_KEY=your_prod_hash_key
ECPAY_PROD_HASH_IV=your_prod_hash_iv
ECPAY_PROD_API_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5

# --------------------------------------------
# Security Configuration
# --------------------------------------------
# JWT secret for authentication (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# CSRF token secret (generate a strong random string)
CSRF_SECRET=your_csrf_secret_key_here

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Cloudflare D1 database binding name (configured in wrangler.toml)
# DB=your_d1_database_binding

# --------------------------------------------
# Logging Configuration
# --------------------------------------------
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Enable detailed payment logs (set to 'false' in production)
ENABLE_PAYMENT_DEBUG_LOGS=true

# --------------------------------------------
# Payment Configuration
# --------------------------------------------
# Default currency
DEFAULT_CURRENCY=TWD

# Payment expiration times (in minutes)
CREDIT_CARD_EXPIRATION_MINUTES=30
ATM_EXPIRATION_DAYS=3
CVS_EXPIRATION_DAYS=3

# Maximum concurrent pending payments per order
MAX_CONCURRENT_PENDING_PAYMENTS=3

# --------------------------------------------
# Notification Configuration
# --------------------------------------------
# Email service configuration (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# NOTIFICATION_EMAIL_FROM=noreply@example.com

# --------------------------------------------
# Monitoring Configuration (optional)
# --------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://your_sentry_dsn

# Analytics tracking ID
# ANALYTICS_ID=your_analytics_id

# --------------------------------------------
# Notes
# --------------------------------------------
# 1. All sensitive values should be stored as Cloudflare Workers secrets
#    Use: wrangler secret put <KEY_NAME>
#
# 2. For production deployment, ensure:
#    - PAYMENT_ENVIRONMENT is set to 'production'
#    - All production credentials are configured
#    - JWT_SECRET and CSRF_SECRET are strong random strings
#    - ENABLE_PAYMENT_DEBUG_LOGS is set to 'false'
#
# 3. Test your configuration in test environment before deploying to production
#
# 4. Keep this file updated when adding new environment variables
